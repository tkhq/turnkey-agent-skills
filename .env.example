# Required by all skills
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=

# Required by signing examples
SIGN_WITH=              # Ethereum address (0x...) or Solana address (base58)

# Optional — chain-specific RPC endpoints (public defaults used if omitted)
ETHEREUM_RPC=           # e.g. https://rpc.ankr.com/eth_sepolia
SOLANA_RPC=             # e.g. https://api.devnet.solana.com

# Optional — example targets
RECIPIENT=              # Override default recipient address in examples
