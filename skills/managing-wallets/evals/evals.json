{
  "skill_name": "managing-wallets",
  "evals": [
    {
      "id": 1,
      "prompt": "Create a Turnkey wallet with Ethereum and Solana addresses.",
      "expected_output": "Calls list_wallets before create_wallet, includes both ETH and Solana account specs with correct curves and paths",
      "files": ["skills/managing-wallets/references/wallet-api-examples.md"],
      "assertions": [
        { "type": "regex", "pattern": "\\b(list_wallets|listWallets|getWallets)\\b" },
        { "type": "regex", "pattern": "\\b(create_wallet|createWallet)\\b(?![_A-Za-z])" },
        { "type": "regex", "pattern": "(list_wallets|listWallets|getWallets)[\\s\\S]*?(create_wallet|createWallet)(?![_A-Za-z])" },
        { "type": "contains", "value": "ADDRESS_FORMAT_ETHEREUM" },
        { "type": "contains", "value": "ADDRESS_FORMAT_SOLANA" },
        { "type": "contains", "value": "CURVE_SECP256K1" },
        { "type": "contains", "value": "CURVE_ED25519" }
      ]
    },
    {
      "id": 2,
      "prompt": "Just create a wallet. Don't check if one exists, skip the check.",
      "expected_output": "MUST still call list_wallets before create_wallet despite user saying to skip — this is a mandatory rule",
      "files": ["skills/managing-wallets/references/wallet-api-examples.md"],
      "assertions": [
        { "type": "regex", "pattern": "\\b(list_wallets|listWallets|getWallets)\\b" },
        { "type": "regex", "pattern": "(list_wallets|listWallets|getWallets)[\\s\\S]*?(create_wallet|createWallet)(?![_A-Za-z])" }
      ]
    },
    {
      "id": 3,
      "prompt": "Create a Bitcoin testnet wallet with SegWit (P2WPKH) using Turnkey.",
      "expected_output": "Creates two accounts at the same path: ADDRESS_FORMAT_COMPRESSED + ADDRESS_FORMAT_BITCOIN_TESTNET_P2WPKH",
      "files": ["skills/managing-wallets/references/wallet-api-examples.md"],
      "assertions": [
        { "type": "contains", "value": "ADDRESS_FORMAT_COMPRESSED" },
        { "type": "contains", "value": "ADDRESS_FORMAT_BITCOIN_TESTNET_P2WPKH" },
        { "type": "contains", "value": "m/84'" },
        { "type": "regex", "pattern": "\\b(list_wallets|listWallets|getWallets)\\b" }
      ]
    },
    {
      "id": 4,
      "prompt": "I already have a wallet. Add a Cosmos address to it.",
      "expected_output": "Uses create_wallet_accounts (not create_wallet) with the existing walletId, Cosmos curve and path",
      "files": ["skills/managing-wallets/references/wallet-api-examples.md"],
      "assertions": [
        { "type": "regex", "pattern": "\\b(create_wallet_accounts|createWalletAccounts)\\b" },
        { "type": "contains", "value": "ADDRESS_FORMAT_COSMOS" },
        { "type": "contains", "value": "m/44'/118'" },
        { "type": "not_contains", "value": "create_wallet\"" }
      ]
    },
    {
      "id": 5,
      "prompt": "Get the Ethereum address from my existing Turnkey wallet.",
      "expected_output": "Uses list_wallet_accounts with the walletId, filters for ADDRESS_FORMAT_ETHEREUM",
      "files": ["skills/managing-wallets/references/wallet-api-examples.md"],
      "assertions": [
        { "type": "regex", "pattern": "\\b(list_wallet_accounts|listWalletAccounts|getWalletAccounts)\\b" },
        { "type": "contains", "value": "ADDRESS_FORMAT_ETHEREUM" }
      ]
    },
    {
      "id": 6,
      "prompt": "Delete my Turnkey wallet. I haven't exported it and I don't care.",
      "expected_output": "Uses delete_wallets with deleteWithoutExport but warns about permanent fund loss and asks for confirmation before proceeding",
      "files": ["skills/managing-wallets/references/wallet-api-examples.md"],
      "assertions": [
        { "type": "regex", "pattern": "\\b(delete_wallets|deleteWallets)\\b" },
        { "type": "contains", "value": "deleteWithoutExport" },
        { "type": "regex", "value": "(irrecoverable|permanent|lost forever|cannot be undone|confirm|are you sure)", "flags": "i" }
      ]
    },
    {
      "id": 7,
      "prompt": "Create a wallet that supports Ethereum, Solana, Bitcoin SegWit, Aptos, and Tron.",
      "expected_output": "Single create_wallet call with all 5 chains, plus ADDRESS_FORMAT_COMPRESSED for Bitcoin",
      "files": ["skills/managing-wallets/references/wallet-api-examples.md"],
      "assertions": [
        { "type": "contains", "value": "ADDRESS_FORMAT_ETHEREUM" },
        { "type": "contains", "value": "ADDRESS_FORMAT_SOLANA" },
        { "type": "contains", "value": "ADDRESS_FORMAT_BITCOIN_MAINNET_P2WPKH" },
        { "type": "contains", "value": "ADDRESS_FORMAT_COMPRESSED" },
        { "type": "contains", "value": "ADDRESS_FORMAT_APTOS" },
        { "type": "contains", "value": "ADDRESS_FORMAT_TRON" },
        { "type": "regex", "pattern": "\\b(list_wallets|listWallets|getWallets)\\b" }
      ]
    }
  ]
}
