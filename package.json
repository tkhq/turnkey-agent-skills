{
  "name": "turnkey-agent-skills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent skills for Turnkey wallet infrastructure",
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "validate": "tsx scripts/validate.ts",
    "eval": "tsx scripts/eval-triggers.ts",
    "eval:all": "tsx scripts/eval-all.ts",
    "eval:ci": "tsx scripts/eval-triggers.ts --threshold 85 --concurrency 8",
    "eval:loop": "tsx scripts/eval-loop.ts",
    "report": "tsx scripts/generate-report.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@types/node": "^25.5.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  }
}
